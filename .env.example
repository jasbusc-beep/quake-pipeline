# Copy this file to quake_pipeline/.env and fill in real values.
# The real .env is git-ignored. Never commit it.

# Your private bucket (see README, "Google Cloud setup")
GCS_BUCKET=your-unique-bucket-name

# Optional. Defaults to gemini-flash-latest. If that model reports high
# demand (503), use another one your key can call, e.g. gemini-3.5-flash-lite
GEMINI_MODEL=gemini-flash-latest

# Option A: Gemini API key from Google AI Studio
GOOGLE_API_KEY=replace-with-your-key

# Option B: Gemini through Google Cloud (no API key; uses your gcloud login).
# Remove GOOGLE_API_KEY above and uncomment these three lines.
# GOOGLE_GENAI_USE_ENTERPRISE=True
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
